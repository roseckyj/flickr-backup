# Flickr API application credentials.
FLICKR_API_KEY=
FLICKR_API_SECRET=

# OAuth access token pair. The existing token can be reused if valid.
FLICKR_AUTH_TOKEN=
FLICKR_AUTH_TOKEN_SECRET=

# Flickr username or a full photostream URL.
FLICKR_USERNAME=
# FLICKR_URL=https://www.flickr.com/photos/your_username/

# Standard five-field cron expression. This runs daily at 03:00.
CRON_SCHEDULE=0 3 * * *

# Delay between media requests; increase if Flickr returns HTTP 429.
DOWNLOAD_DELAY=1

# Cooldown after Flickr returns HTTP 429.
RATE_LIMIT_DELAY=60

# Browser-like User-Agent used for Flickr media requests.
DOWNLOAD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36

